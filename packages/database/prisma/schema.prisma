// COOBRA — Phase 1 schema: authentication and users only.
// Shipment and accounting models are intentionally not part of this phase.

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  SUPER_ADMIN
  ACCOUNTANT
  OWNER_VIEWER
  OPERATIONS
  DRIVER
  MERCHANT
}

enum UserStatus {
  ACTIVE
  DISABLED
}

enum Language {
  ar
  en
}

enum ClientApp {
  ADMIN_WEB
  DRIVER_APP
  MERCHANT_APP
}

enum AuthTokenPurpose {
  EMAIL_VERIFICATION
  PASSWORD_RESET
  ACCOUNT_SETUP
}

model User {
  id                String     @id @default(uuid(7)) @db.Uuid
  /// Always stored lower-cased and trimmed.
  email             String     @unique
  /// Argon2id hash. Null until an invited user sets a password.
  passwordHash      String?    @map("password_hash")
  fullName          String     @map("full_name")
  phone             String?
  role              UserRole
  status            UserStatus @default(ACTIVE)
  language          Language
  emailVerifiedAt   DateTime?  @map("email_verified_at")
  passwordChangedAt DateTime?  @map("password_changed_at")
  createdById       String?    @map("created_by_id") @db.Uuid
  createdAt         DateTime   @default(now()) @map("created_at")
  updatedAt         DateTime   @updatedAt @map("updated_at")

  createdBy         User?            @relation("UserCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdUsers      User[]           @relation("UserCreatedBy")
  merchantProfile   MerchantProfile?
  sessions          Session[]
  authTokens        AuthToken[]
  auditLogsAsActor  AuditLog[]       @relation("AuditActor")
  auditLogsAsTarget AuditLog[]       @relation("AuditTarget")

  @@index([role])
  @@map("users")
}

model MerchantProfile {
  userId       String   @id @map("user_id") @db.Uuid
  businessName String   @map("business_name")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("merchant_profiles")
}

/// Server-side session. Only the SHA-256 hash of the opaque session token is stored.
model Session {
  id         String    @id @default(uuid(7)) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  tokenHash  String    @unique @map("token_hash")
  clientApp  ClientApp @map("client_app")
  ipAddress  String?   @map("ip_address")
  userAgent  String?   @map("user_agent")
  createdAt  DateTime  @default(now()) @map("created_at")
  lastUsedAt DateTime  @default(now()) @map("last_used_at")
  expiresAt  DateTime  @map("expires_at")
  revokedAt  DateTime? @map("revoked_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

/// Single-use tokens for email verification, password reset and account setup.
/// Only the SHA-256 hash of the token is stored.
model AuthToken {
  id        String           @id @default(uuid(7)) @db.Uuid
  userId    String           @map("user_id") @db.Uuid
  purpose   AuthTokenPurpose
  tokenHash String           @unique @map("token_hash")
  expiresAt DateTime         @map("expires_at")
  usedAt    DateTime?        @map("used_at")
  createdAt DateTime         @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose])
  @@map("auth_tokens")
}

/// Append-only security audit trail (authentication events, account administration).
/// Prepared for impersonation: `actorUserId` is always the real human who acted.
model AuditLog {
  id           String   @id @default(uuid(7)) @db.Uuid
  action       String
  actorUserId  String?  @map("actor_user_id") @db.Uuid
  targetUserId String?  @map("target_user_id") @db.Uuid
  ipAddress    String?  @map("ip_address")
  userAgent    String?  @map("user_agent")
  metadata     Json?
  createdAt    DateTime @default(now()) @map("created_at")

  actor  User? @relation("AuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)
  target User? @relation("AuditTarget", fields: [targetUserId], references: [id], onDelete: SetNull)

  @@index([actorUserId])
  @@index([targetUserId])
  @@index([action, createdAt])
  @@map("audit_logs")
}
