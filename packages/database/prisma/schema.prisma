// COOBRA schema.
// Phase 1: authentication and users. Phase 2: shipments, status history, COD collection records.
// Financial settlements, payouts and accounting ledgers are intentionally not modelled yet.

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  SUPER_ADMIN
  ACCOUNTANT
  OWNER_VIEWER
  OPERATIONS
  DRIVER
  MERCHANT
}

enum UserStatus {
  ACTIVE
  DISABLED
}

enum Language {
  ar
  en
}

enum ClientApp {
  ADMIN_WEB
  DRIVER_APP
  MERCHANT_APP
}

enum AuthTokenPurpose {
  EMAIL_VERIFICATION
  PASSWORD_RESET
  ACCOUNT_SETUP
}

model User {
  id                String     @id @default(uuid(7)) @db.Uuid
  /// Always stored lower-cased and trimmed.
  email             String     @unique
  /// Argon2id hash. Null until an invited user sets a password.
  passwordHash      String?    @map("password_hash")
  fullName          String     @map("full_name")
  phone             String?
  role              UserRole
  status            UserStatus @default(ACTIVE)
  language          Language
  emailVerifiedAt   DateTime?  @map("email_verified_at")
  passwordChangedAt DateTime?  @map("password_changed_at")
  createdById       String?    @map("created_by_id") @db.Uuid
  createdAt         DateTime   @default(now()) @map("created_at")
  updatedAt         DateTime   @updatedAt @map("updated_at")

  createdBy              User?                   @relation("UserCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdUsers           User[]                  @relation("UserCreatedBy")
  merchantProfile        MerchantProfile?
  sessions               Session[]
  authTokens             AuthToken[]
  auditLogsAsActor       AuditLog[]              @relation("AuditActor")
  auditLogsAsTarget      AuditLog[]              @relation("AuditTarget")
  merchantShipments      Shipment[]              @relation("ShipmentMerchant")
  createdShipments       Shipment[]              @relation("ShipmentCreator")
  driverShipments        Shipment[]              @relation("ShipmentDriver")
  statusChanges          ShipmentStatusHistory[] @relation("ShipmentHistoryActor")
  historyAsDriver        ShipmentStatusHistory[] @relation("ShipmentHistoryDriver")
  codCollections         CodCollection[]         @relation("CodCollectionDriver")
  pricingRules           PricingRule[]           @relation("PricingRuleMerchant")
  createdPricingRules    PricingRule[]           @relation("PricingRuleCreator")
  pricingQuotes          PricingQuote[]          @relation("PricingQuoteMerchant")
  feeOverrides           ShipmentFeeOverride[]   @relation("FeeOverrideActor")
  approvedFeeOverrides   ShipmentFeeOverride[]   @relation("FeeOverrideApprover")
  financialAccounts      FinancialAccount[]      @relation("FinancialAccountOwner")
  journalEntries         JournalEntry[]          @relation("JournalEntryCreator")
  merchantShortfalls     CodShortfall[]          @relation("ShortfallMerchant")
  driverShortfalls       CodShortfall[]          @relation("ShortfallDriver")
  proposedShortfalls     CodShortfall[]          @relation("ShortfallProposer")
  decidedShortfalls      CodShortfall[]          @relation("ShortfallDecider")
  merchantAdjustments    FinancialAdjustment[]   @relation("AdjustmentMerchant")
  requestedAdjustments   FinancialAdjustment[]   @relation("AdjustmentRequester")
  decidedAdjustments     FinancialAdjustment[]   @relation("AdjustmentDecider")
  settingChanges         FinanceSettingChange[]  @relation("SettingChanger")
  driverSettlements      DriverSettlement[]      @relation("SettlementDriver")
  submittedSettlements   DriverSettlement[]      @relation("SettlementSubmitter")
  decidedSettlements     DriverSettlement[]      @relation("SettlementDecider")
  driverShortages        DriverCashShortage[]    @relation("ShortageDriver")
  proposedShortages      DriverCashShortage[]    @relation("ShortageProposer")
  decidedShortages       DriverCashShortage[]    @relation("ShortageDecider")
  driverRepayments       DriverRepayment[]       @relation("RepaymentDriver")
  recordedRepayments     DriverRepayment[]       @relation("RepaymentRecorder")
  merchantPayouts        MerchantPayout[]        @relation("PayoutMerchant")
  createdPayouts         MerchantPayout[]        @relation("PayoutCreator")
  approvedPayouts        MerchantPayout[]        @relation("PayoutApprover")
  paidPayouts            MerchantPayout[]        @relation("PayoutPayer")
  cancelledPayouts       MerchantPayout[]        @relation("PayoutCanceller")
  merchantPayments       MerchantPayment[]       @relation("MerchantPaymentMerchant")
  recordedPayments       MerchantPayment[]       @relation("MerchantPaymentRecorder")
  treasuryTransfers      TreasuryTransfer[]      @relation("TransferRecorder")
  requestedReturns       ReturnRecord[]          @relation("ReturnRequester")
  approvedReturns        ReturnRecord[]          @relation("ReturnApprover")
  returnTasks            ReturnRecord[]          @relation("ReturnDriver")
  returnFeeDecisions     ReturnRecord[]          @relation("ReturnFeeSetter")
  pickupZoneRequests     PickupZoneRequest[]     @relation("PickupRequestMerchant")
  pickupZoneDecisions    PickupZoneRequest[]     @relation("PickupRequestDecider")
  impersonationsAsActor  ImpersonationSession[]  @relation("ImpersonationActor")
  impersonationsAsTarget ImpersonationSession[]  @relation("ImpersonationTarget")
  notifications          NotificationOutbox[]    @relation("NotificationRecipient")

  @@index([role])
  @@map("users")
}

model MerchantProfile {
  userId              String   @id @map("user_id") @db.Uuid
  businessName        String   @map("business_name")
  /// Phase 3: default origin zone used for pricing (nullable for existing merchants).
  defaultPickupZoneId String?  @map("default_pickup_zone_id") @db.Uuid
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  user              User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  defaultPickupZone Zone? @relation("MerchantPickupZone", fields: [defaultPickupZoneId], references: [id], onDelete: Restrict)

  @@map("merchant_profiles")
}

/// Server-side session. Only the SHA-256 hash of the opaque session token is stored.
model Session {
  id                String    @id @default(uuid(7)) @db.Uuid
  userId            String    @map("user_id") @db.Uuid
  tokenHash         String    @unique @map("token_hash")
  clientApp         ClientApp @map("client_app")
  ipAddress         String?   @map("ip_address")
  userAgent         String?   @map("user_agent")
  createdAt         DateTime  @default(now()) @map("created_at")
  lastUsedAt        DateTime  @default(now()) @map("last_used_at")
  expiresAt         DateTime  @map("expires_at")
  revokedAt         DateTime? @map("revoked_at")
  /// Phase 4C: the last password re-entry on this admin session (step-up before impersonating).
  reauthenticatedAt DateTime? @map("reauthenticated_at")
  /// Phase 4C: set only on the temporary session an impersonation creates. `userId` is then the
  /// impersonated account (the database checks it is that impersonation's target).
  impersonationId   String?   @unique @map("impersonation_id") @db.Uuid

  user                  User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  impersonation         ImpersonationSession?  @relation("ImpersonationTemporarySession", fields: [impersonationId, userId], references: [id, targetUserId], onDelete: Restrict, onUpdate: Restrict)
  startedImpersonations ImpersonationSession[] @relation("ImpersonationActorSession")

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

/// Single-use tokens for email verification, password reset and account setup.
/// Only the SHA-256 hash of the token is stored.
model AuthToken {
  id        String           @id @default(uuid(7)) @db.Uuid
  userId    String           @map("user_id") @db.Uuid
  purpose   AuthTokenPurpose
  tokenHash String           @unique @map("token_hash")
  expiresAt DateTime         @map("expires_at")
  usedAt    DateTime?        @map("used_at")
  createdAt DateTime         @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose])
  @@map("auth_tokens")
}

/// Append-only security audit trail (authentication events, account administration).
/// Prepared for impersonation: `actorUserId` is always the real human who acted.
model AuditLog {
  id              String   @id @default(uuid(7)) @db.Uuid
  action          String
  actorUserId     String?  @map("actor_user_id") @db.Uuid
  targetUserId    String?  @map("target_user_id") @db.Uuid
  ipAddress       String?  @map("ip_address")
  userAgent       String?  @map("user_agent")
  metadata        Json?
  createdAt       DateTime @default(now()) @map("created_at")
  /// Phase 4C: the impersonated account whose authority was used. NULL outside impersonation;
  /// `actorUserId` is still the real human. Set together with `impersonationId` (CHECK).
  effectiveUserId String?  @map("effective_user_id") @db.Uuid
  impersonationId String?  @map("impersonation_id") @db.Uuid

  actor               User?                 @relation("AuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)
  target              User?                 @relation("AuditTarget", fields: [targetUserId], references: [id], onDelete: SetNull)
  /// Composite keys: the actor and the effective account must be that impersonation's own.
  impersonationActor  ImpersonationSession? @relation("AuditImpersonationActor", fields: [impersonationId, actorUserId], references: [id, actorUserId], onDelete: Restrict, onUpdate: Restrict)
  impersonationTarget ImpersonationSession? @relation("AuditImpersonationTarget", fields: [impersonationId, effectiveUserId], references: [id, targetUserId], onDelete: Restrict, onUpdate: Restrict)

  @@index([actorUserId])
  @@index([targetUserId])
  @@index([action, createdAt])
  // Audit log viewer: newest-first pages, per-person history and entity lookups (metadata @>).
  @@index([createdAt(sort: Desc), id(sort: Desc)])
  @@index([actorUserId, createdAt(sort: Desc)])
  @@index([targetUserId, createdAt(sort: Desc)])
  @@index([metadata(ops: JsonbOps)], type: Gin)
  // Phase 4C: everything done in one impersonation, and everything done as one account.
  @@index([impersonationId, createdAt(sort: Desc)])
  @@index([effectiveUserId, createdAt(sort: Desc)])
  @@map("audit_logs")
}

// ---------------------------------------------------------------------------
// Phase 2 — shipments
// ---------------------------------------------------------------------------

enum ShipmentStatus {
  CREATED
  ASSIGNED
  PICKED_UP
  OUT_FOR_DELIVERY
  DELIVERED
  DELIVERY_FAILED
  RETURN_REQUESTED
  /// Phase 3: return approved/scheduled, usually with a return driver.
  RETURN_APPROVED
  /// Phase 3: the driver is carrying the parcel back.
  RETURN_IN_TRANSIT
  /// Phase 3: back at the company hub, waiting for the merchant.
  RETURNED_TO_HUB
  /// Returned to the merchant (final).
  RETURNED
  CANCELLED
}

enum Currency {
  ILS
}

/// A parcel to deliver. Always owned by a merchant; creator and every status change are recorded.
/// Money is stored as DECIMAL(12,2), never as floating point.
model Shipment {
  id                     String         @id @default(uuid(7)) @db.Uuid
  /// Human-readable, unique tracking number (e.g. CB-48213907).
  trackingNumber         String         @unique @map("tracking_number")
  merchantId             String         @map("merchant_id") @db.Uuid
  /// The real user who created the shipment (the merchant, or a staff member on their behalf).
  createdById            String?        @map("created_by_id") @db.Uuid
  creatorRole            UserRole       @map("creator_role")
  recipientName          String         @map("recipient_name")
  /// Normalised: local (0599…) or E.164 (+970599…).
  recipientPhone         String         @map("recipient_phone")
  recipientPhoneAlt      String?        @map("recipient_phone_alt")
  /// Governorate code from @coobra/shared GOVERNORATES (validated by the API).
  governorate            String
  city                   String
  addressLine            String         @map("address_line")
  landmark               String?
  recipientNotes         String?        @map("recipient_notes")
  merchantNotes          String?        @map("merchant_notes")
  codAmount              Decimal        @map("cod_amount") @db.Decimal(12, 2)
  /// Null until priced (merchant-created shipments).
  deliveryFee            Decimal?       @map("delivery_fee") @db.Decimal(12, 2)
  currency               Currency       @default(ILS)
  status                 ShipmentStatus @default(CREATED)
  driverId               String?        @map("driver_id") @db.Uuid
  assignedAt             DateTime?      @map("assigned_at")
  pickedUpAt             DateTime?      @map("picked_up_at")
  deliveredAt            DateTime?      @map("delivered_at")
  deliveredById          String?        @map("delivered_by_id") @db.Uuid
  deliveryAttempts       Int            @default(0) @map("delivery_attempts")
  failureReason          String?        @map("failure_reason")
  cancellationReason     String?        @map("cancellation_reason")
  returnReason           String?        @map("return_reason")
  /// Phase 3: cash-on-delivery progress (separate from the delivery status).
  codStatus              CodStatus      @default(PENDING) @map("cod_status")
  codCollectedAmount     Decimal        @default(0) @map("cod_collected_amount") @db.Decimal(12, 2)
  /// Phase 3: pricing zones (nullable for Phase 2 shipments).
  originZoneId           String?        @map("origin_zone_id") @db.Uuid
  destinationZoneId      String?        @map("destination_zone_id") @db.Uuid
  /// Optimistic concurrency token, incremented on every change.
  version                Int            @default(0)
  createdAt              DateTime       @default(now()) @map("created_at")
  updatedAt              DateTime       @updatedAt @map("updated_at")
  /// Phase 4C: set when the shipment was created during an impersonation. `createdById` is then
  /// the real SUPER_ADMIN and `merchantId` the impersonated merchant (checked by composite keys).
  createdImpersonationId String?        @map("created_impersonation_id") @db.Uuid

  merchant                   User                    @relation("ShipmentMerchant", fields: [merchantId], references: [id], onDelete: Restrict)
  createdBy                  User?                   @relation("ShipmentCreator", fields: [createdById], references: [id], onDelete: SetNull)
  createdImpersonationActor  ImpersonationSession?   @relation("ShipmentImpersonationActor", fields: [createdImpersonationId, createdById], references: [id, actorUserId], onDelete: Restrict, onUpdate: Restrict)
  createdImpersonationTarget ImpersonationSession?   @relation("ShipmentImpersonationTarget", fields: [createdImpersonationId, merchantId], references: [id, targetUserId], onDelete: Restrict, onUpdate: Restrict)
  driver                     User?                   @relation("ShipmentDriver", fields: [driverId], references: [id], onDelete: Restrict)
  history                    ShipmentStatusHistory[]
  codCollections             CodCollection[]
  originZone                 Zone?                   @relation("ShipmentOriginZone", fields: [originZoneId], references: [id], onDelete: Restrict)
  destinationZone            Zone?                   @relation("ShipmentDestinationZone", fields: [destinationZoneId], references: [id], onDelete: Restrict)
  pricing                    ShipmentPricing?
  feeOverrides               ShipmentFeeOverride[]
  pricingQuote               PricingQuote?
  shortfall                  CodShortfall?
  returnRecord               ReturnRecord?
  journalLines               JournalLine[]
  adjustmentSources          FinancialAdjustment[]   @relation("AdjustmentSourceShipment")

  @@index([merchantId, createdAt(sort: Desc)])
  @@index([driverId, status])
  @@index([status, createdAt(sort: Desc)])
  @@index([governorate])
  @@index([recipientPhone])
  @@index([createdAt(sort: Desc)])
  @@index([destinationZoneId])
  @@index([createdImpersonationId])
  @@map("shipments")
}

/// Append-only record of every status change and (re)assignment.
model ShipmentStatusHistory {
  id              String          @id @default(uuid(7)) @db.Uuid
  shipmentId      String          @map("shipment_id") @db.Uuid
  fromStatus      ShipmentStatus? @map("from_status")
  toStatus        ShipmentStatus  @map("to_status")
  /// The real human who acted (never an impersonated identity).
  actorUserId     String?         @map("actor_user_id") @db.Uuid
  actorRole       UserRole        @map("actor_role")
  /// For assignment entries: the driver assigned.
  driverId        String?         @map("driver_id") @db.Uuid
  note            String?
  createdAt       DateTime        @default(now()) @map("created_at")
  /// Phase 4C: set when the change was made during an impersonation. `actorUserId`/`actorRole`
  /// stay the real human; the impersonated account comes from the impersonation.
  impersonationId String?         @map("impersonation_id") @db.Uuid

  shipment      Shipment              @relation(fields: [shipmentId], references: [id], onDelete: Restrict)
  actor         User?                 @relation("ShipmentHistoryActor", fields: [actorUserId], references: [id], onDelete: SetNull)
  driver        User?                 @relation("ShipmentHistoryDriver", fields: [driverId], references: [id], onDelete: SetNull)
  /// Composite key: the recorded actor must be that impersonation's actor.
  impersonation ImpersonationSession? @relation("HistoryImpersonation", fields: [impersonationId, actorUserId], references: [id, actorUserId], onDelete: Restrict, onUpdate: Restrict)

  @@index([shipmentId, createdAt])
  @@index([actorUserId])
  @@index([impersonationId])
  @@map("shipment_status_history")
}

/// Operational record of cash on delivery reported by the driver when a shipment is delivered.
/// Not a ledger: Phase 3 reconciliation and settlements will reference these rows.
model CodCollection {
  id              String   @id @default(uuid(7)) @db.Uuid
  shipmentId      String   @map("shipment_id") @db.Uuid
  driverId        String   @map("driver_id") @db.Uuid
  collected       Boolean
  expectedAmount  Decimal  @map("expected_amount") @db.Decimal(12, 2)
  collectedAmount Decimal  @map("collected_amount") @db.Decimal(12, 2)
  currency        Currency @default(ILS)
  recordedAt      DateTime @default(now()) @map("recorded_at")
  /// Phase 3: portion handed to the company (settlement) or resolved as a driver cash shortage.
  clearedAmount   Decimal  @default(0) @map("cleared_amount") @db.Decimal(12, 2)
  /// Phase 3: client-supplied key for follow-up collections (prevents double posting).
  idempotencyKey  String?  @unique @map("idempotency_key")
  note            String?

  shipment  Shipment       @relation(fields: [shipmentId], references: [id], onDelete: Restrict)
  driver    User           @relation("CodCollectionDriver", fields: [driverId], references: [id], onDelete: Restrict)
  clearings CashClearing[]

  @@index([shipmentId])
  @@index([driverId, recordedAt])
  @@map("cod_collections")
}

// ---------------------------------------------------------------------------
// Phase 3 — zones and pricing
// ---------------------------------------------------------------------------

/// Configurable labels for zone levels (region, governorate, city, town, subzone, …).
model ZoneKind {
  id        String   @id @default(uuid(7)) @db.Uuid
  code      String   @unique
  nameAr    String   @map("name_ar")
  nameEn    String   @map("name_en")
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  zones Zone[]

  @@map("zone_kinds")
}

/// Hierarchical delivery zone. `code` is the stable identifier; names are for display only.
/// The parent is fixed at creation, so `depth` (0 = root) never changes.
model Zone {
  id        String   @id @default(uuid(7)) @db.Uuid
  code      String   @unique
  kindId    String   @map("kind_id") @db.Uuid
  parentId  String?  @map("parent_id") @db.Uuid
  depth     Int      @default(0)
  nameAr    String   @map("name_ar")
  nameEn    String   @map("name_en")
  active    Boolean  @default(true)
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  kind     ZoneKind @relation(fields: [kindId], references: [id], onDelete: Restrict)
  parent   Zone?    @relation("ZoneTree", fields: [parentId], references: [id], onDelete: Restrict)
  children Zone[]   @relation("ZoneTree")

  merchantPickups      MerchantProfile[]   @relation("MerchantPickupZone")
  originShipments      Shipment[]          @relation("ShipmentOriginZone")
  destinationShipments Shipment[]          @relation("ShipmentDestinationZone")
  originRules          PricingRule[]       @relation("PricingRuleOrigin")
  destinationRules     PricingRule[]       @relation("PricingRuleDestination")
  requestedPickups     PickupZoneRequest[] @relation("PickupRequestZone")
  previousPickups      PickupZoneRequest[] @relation("PickupRequestPreviousZone")

  @@index([parentId])
  @@map("zones")
}

enum PricingSource {
  MERCHANT_ROUTE
  GENERAL_ROUTE
  MERCHANT_FALLBACK
  GENERAL_FALLBACK
  MANUAL
  LEGACY
}

/// What a returned (never delivered) shipment is charged. RETURN_ONLY is the Phase 3
/// behaviour and the default for every rule, snapshot and return record that predates it.
enum ReturnFeePolicy {
  /// Only the return fee.
  RETURN_ONLY
  /// The shipment's delivery fee plus the return fee (after a failed delivery attempt).
  DELIVERY_PLUS_RETURN
  /// The rule's failed-attempt fee plus the return fee (after a failed delivery attempt).
  REDUCED_ATTEMPT_PLUS_RETURN
}

/// A versioned delivery price. Editing creates a new version (same `ruleGroupId`) and deactivates
/// the previous one, so the rule a shipment was priced with is always preserved.
model PricingRule {
  id                String          @id @default(uuid(7)) @db.Uuid
  ruleGroupId       String          @map("rule_group_id") @db.Uuid
  version           Int             @default(1)
  /// Null = general rule; otherwise only for this merchant.
  merchantId        String?         @map("merchant_id") @db.Uuid
  originZoneId      String?         @map("origin_zone_id") @db.Uuid
  destinationZoneId String?         @map("destination_zone_id") @db.Uuid
  /// Explicit fallback: applies when no route rule matches (zones must be null).
  isFallback        Boolean         @default(false) @map("is_fallback")
  deliveryFee       Decimal         @map("delivery_fee") @db.Decimal(12, 2)
  /// Null = return fee not configured (RETURN_FEE_UNCONFIGURED).
  returnFee         Decimal?        @map("return_fee") @db.Decimal(12, 2)
  /// What a return is charged. Part of the version: changing it creates a new version.
  returnPolicy      ReturnFeePolicy @default(RETURN_ONLY) @map("return_policy")
  /// Failed-attempt fee; set only (and required) for REDUCED_ATTEMPT_PLUS_RETURN (DB check).
  attemptFee        Decimal?        @map("attempt_fee") @db.Decimal(12, 2)
  currency          Currency        @default(ILS)
  priority          Int             @default(0)
  effectiveFrom     DateTime        @default(now()) @map("effective_from")
  effectiveTo       DateTime?       @map("effective_to")
  active            Boolean         @default(true)
  note              String?
  createdById       String?         @map("created_by_id") @db.Uuid
  createdAt         DateTime        @default(now()) @map("created_at")
  supersededAt      DateTime?       @map("superseded_at")

  merchant        User?             @relation("PricingRuleMerchant", fields: [merchantId], references: [id], onDelete: Restrict)
  originZone      Zone?             @relation("PricingRuleOrigin", fields: [originZoneId], references: [id], onDelete: Restrict)
  destinationZone Zone?             @relation("PricingRuleDestination", fields: [destinationZoneId], references: [id], onDelete: Restrict)
  createdBy       User?             @relation("PricingRuleCreator", fields: [createdById], references: [id], onDelete: SetNull)
  quotes          PricingQuote[]
  snapshots       ShipmentPricing[]

  @@unique([ruleGroupId, version])
  @@index([active, merchantId])
  @@index([originZoneId, destinationZoneId])
  @@map("pricing_rules")
}

enum PickupZoneRequestStatus {
  PENDING
  APPROVED
  REJECTED
  WITHDRAWN
}

/// A merchant's request to change their pickup zone. Prices use the approved zone on the
/// merchant profile; a request only takes effect when staff approve it. At most one PENDING
/// request per merchant (partial unique index in migration 20261026100000_pickup_zone_requests).
model PickupZoneRequest {
  id              String                  @id @default(uuid(7)) @db.Uuid
  merchantId      String                  @map("merchant_id") @db.Uuid
  requestedZoneId String                  @map("requested_zone_id") @db.Uuid
  /// The approved zone when the request was made.
  previousZoneId  String?                 @map("previous_zone_id") @db.Uuid
  status          PickupZoneRequestStatus @default(PENDING)
  /// Staff who approved or rejected; null while pending or when the merchant withdrew.
  decidedById     String?                 @map("decided_by_id") @db.Uuid
  decidedAt       DateTime?               @map("decided_at")
  decisionNote    String?                 @map("decision_note")
  createdAt       DateTime                @default(now()) @map("created_at")

  merchant      User  @relation("PickupRequestMerchant", fields: [merchantId], references: [id], onDelete: Restrict)
  requestedZone Zone  @relation("PickupRequestZone", fields: [requestedZoneId], references: [id], onDelete: Restrict)
  previousZone  Zone? @relation("PickupRequestPreviousZone", fields: [previousZoneId], references: [id], onDelete: Restrict)
  decidedBy     User? @relation("PickupRequestDecider", fields: [decidedById], references: [id], onDelete: Restrict)

  @@index([status, createdAt])
  @@index([merchantId, createdAt])
  @@map("pickup_zone_requests")
}

/// A single-use price quote shown to a merchant, valid until `expiresAt`.
model PricingQuote {
  id                String        @id @default(uuid(7)) @db.Uuid
  merchantId        String        @map("merchant_id") @db.Uuid
  originZoneId      String        @map("origin_zone_id") @db.Uuid
  destinationZoneId String        @map("destination_zone_id") @db.Uuid
  ruleId            String        @map("rule_id") @db.Uuid
  ruleVersion       Int           @map("rule_version")
  source            PricingSource
  deliveryFee       Decimal       @map("delivery_fee") @db.Decimal(12, 2)
  returnFee         Decimal?      @map("return_fee") @db.Decimal(12, 2)
  currency          Currency      @default(ILS)
  createdById       String        @map("created_by_id") @db.Uuid
  createdAt         DateTime      @default(now()) @map("created_at")
  expiresAt         DateTime      @map("expires_at")
  usedAt            DateTime?     @map("used_at")
  shipmentId        String?       @unique @map("shipment_id") @db.Uuid
  /// Phase 4C: set when the quote was requested during an impersonation. `createdById` is then
  /// the real SUPER_ADMIN and `merchantId` the impersonated merchant (checked by composite keys).
  impersonationId   String?       @map("impersonation_id") @db.Uuid

  merchant            User                  @relation("PricingQuoteMerchant", fields: [merchantId], references: [id], onDelete: Restrict)
  rule                PricingRule           @relation(fields: [ruleId], references: [id], onDelete: Restrict)
  shipment            Shipment?             @relation(fields: [shipmentId], references: [id], onDelete: Restrict)
  impersonationActor  ImpersonationSession? @relation("QuoteImpersonationActor", fields: [impersonationId, createdById], references: [id, actorUserId], onDelete: Restrict, onUpdate: Restrict)
  impersonationTarget ImpersonationSession? @relation("QuoteImpersonationTarget", fields: [impersonationId, merchantId], references: [id, targetUserId], onDelete: Restrict, onUpdate: Restrict)

  @@index([merchantId, createdAt])
  @@index([impersonationId])
  @@map("pricing_quotes")
}

/// Immutable record of how a shipment was priced. Rule changes never touch it.
model ShipmentPricing {
  shipmentId        String          @id @map("shipment_id") @db.Uuid
  quoteId           String?         @unique @map("quote_id") @db.Uuid
  ruleId            String?         @map("rule_id") @db.Uuid
  ruleVersion       Int?            @map("rule_version")
  source            PricingSource
  originZoneId      String?         @map("origin_zone_id") @db.Uuid
  destinationZoneId String?         @map("destination_zone_id") @db.Uuid
  /// Automatically calculated fee (null when no rule applied).
  baseFee           Decimal?        @map("base_fee") @db.Decimal(12, 2)
  /// Fee charged when priced (later changes are recorded as overrides).
  finalFee          Decimal         @map("final_fee") @db.Decimal(12, 2)
  /// Return fee from the rule; null = not configured.
  returnFee         Decimal?        @map("return_fee") @db.Decimal(12, 2)
  /// The rule's return policy when priced (RETURN_ONLY when no rule applied).
  returnPolicy      ReturnFeePolicy @default(RETURN_ONLY) @map("return_policy")
  /// The rule's failed-attempt fee when priced (REDUCED_ATTEMPT_PLUS_RETURN only).
  attemptFee        Decimal?        @map("attempt_fee") @db.Decimal(12, 2)
  currency          Currency        @default(ILS)
  pricedAt          DateTime        @default(now()) @map("priced_at")
  pricedById        String?         @map("priced_by_id") @db.Uuid

  shipment Shipment     @relation(fields: [shipmentId], references: [id], onDelete: Restrict)
  rule     PricingRule? @relation(fields: [ruleId], references: [id], onDelete: Restrict)

  @@map("shipment_pricing")
}

enum FeeOverridePhase {
  PRE_DELIVERY
  POST_DELIVERY
}

enum ApprovalStatus {
  APPLIED
  PENDING_APPROVAL
  REJECTED
}

/// Append-only history of manual delivery-fee changes (reason mandatory).
model ShipmentFeeOverride {
  id           String           @id @default(uuid(7)) @db.Uuid
  shipmentId   String           @map("shipment_id") @db.Uuid
  phase        FeeOverridePhase
  status       ApprovalStatus
  previousFee  Decimal?         @map("previous_fee") @db.Decimal(12, 2)
  newFee       Decimal          @map("new_fee") @db.Decimal(12, 2)
  reason       String
  actorId      String           @map("actor_id") @db.Uuid
  actorRole    UserRole         @map("actor_role")
  approvedById String?          @map("approved_by_id") @db.Uuid
  decidedAt    DateTime?        @map("decided_at")
  decisionNote String?          @map("decision_note")
  createdAt    DateTime         @default(now()) @map("created_at")

  shipment   Shipment @relation(fields: [shipmentId], references: [id], onDelete: Restrict)
  actor      User     @relation("FeeOverrideActor", fields: [actorId], references: [id], onDelete: Restrict)
  approvedBy User?    @relation("FeeOverrideApprover", fields: [approvedById], references: [id], onDelete: Restrict)

  @@index([shipmentId, createdAt])
  @@map("shipment_fee_overrides")
}

// ---------------------------------------------------------------------------
// Phase 3 — ledger, COD shortfalls, adjustments and finance settings
// ---------------------------------------------------------------------------

enum CodStatus {
  NOT_REQUIRED
  PENDING
  PARTIAL
  COLLECTED
  SHORTFALL_RESOLVED
}

enum AccountType {
  ASSET
  LIABILITY
  REVENUE
  EXPENSE
}

enum AccountPurpose {
  COMPANY_CASH_HUB
  COMPANY_BANK
  COMPANY_EWALLET
  DRIVER_CUSTODY
  DRIVER_RECEIVABLE
  MERCHANT_COD_PENDING
  MERCHANT_BALANCE
  DELIVERY_FEE_REVENUE
  RETURN_FEE_REVENUE
  COD_SHORTFALL_EXPENSE
  DRIVER_CASH_LOSS_EXPENSE
  ADJUSTMENT_EXPENSE
}

/// Ledger account. Company accounts have no owner; driver/merchant accounts one per person.
model FinancialAccount {
  id          String         @id @default(uuid(7)) @db.Uuid
  /// e.g. COMPANY_CASH_HUB or MERCHANT_BALANCE:<user id>
  code        String         @unique
  purpose     AccountPurpose
  type        AccountType
  ownerUserId String?        @map("owner_user_id") @db.Uuid
  currency    Currency       @default(ILS)
  createdAt   DateTime       @default(now()) @map("created_at")

  owner User?         @relation("FinancialAccountOwner", fields: [ownerUserId], references: [id], onDelete: Restrict)
  lines JournalLine[]

  @@index([purpose])
  @@map("financial_accounts")
}

enum JournalKind {
  COD_COLLECTION
  DELIVERY_FEE
  RETURN_FEE
  FEE_ADJUSTMENT
  DRIVER_SETTLEMENT
  DRIVER_CASH_SHORTAGE
  DRIVER_REPAYMENT
  COD_SHORTFALL
  MERCHANT_PAYOUT
  MERCHANT_PAYMENT
  TREASURY_TRANSFER
  MERCHANT_ADJUSTMENT
  REVERSAL
  PHASE2_BACKFILL
}

/// Immutable, balanced journal entry (enforced by database triggers).
/// Two partial unique indexes (migration 20261026090000_journal_source_guards, not expressible
/// here) allow one posting per COD collection and one per shipment delivery fee across the live
/// path and the Phase 2 backfill.
model JournalEntry {
  id           String      @id @default(uuid(7)) @db.Uuid
  kind         JournalKind
  /// Business reference, unique per kind: one posting per source.
  sourceType   String      @map("source_type")
  sourceId     String      @map("source_id")
  reversalOfId String?     @unique @map("reversal_of_id") @db.Uuid
  description  String?
  currency     Currency    @default(ILS)
  createdById  String?     @map("created_by_id") @db.Uuid
  createdAt    DateTime    @default(now()) @map("created_at")

  createdBy         User?                 @relation("JournalEntryCreator", fields: [createdById], references: [id], onDelete: Restrict)
  reversalOf        JournalEntry?         @relation("JournalReversal", fields: [reversalOfId], references: [id], onDelete: Restrict)
  reversedBy        JournalEntry?         @relation("JournalReversal")
  lines             JournalLine[]
  adjustmentSources FinancialAdjustment[] @relation("AdjustmentSourceEntry")

  @@unique([kind, sourceType, sourceId])
  @@index([createdAt])
  @@map("journal_entries")
}

enum EntrySide {
  DEBIT
  CREDIT
}

model JournalLine {
  id         String    @id @default(uuid(7)) @db.Uuid
  entryId    String    @map("entry_id") @db.Uuid
  accountId  String    @map("account_id") @db.Uuid
  side       EntrySide
  amount     Decimal   @db.Decimal(14, 2)
  shipmentId String?   @map("shipment_id") @db.Uuid
  createdAt  DateTime  @default(now()) @map("created_at")

  entry    JournalEntry     @relation(fields: [entryId], references: [id], onDelete: Restrict)
  account  FinancialAccount @relation(fields: [accountId], references: [id], onDelete: Restrict)
  shipment Shipment?        @relation(fields: [shipmentId], references: [id], onDelete: Restrict)

  @@index([accountId, createdAt])
  @@index([entryId])
  @@index([shipmentId])
  @@map("journal_lines")
}

enum ShortfallStatus {
  OPEN
  PENDING_APPROVAL
  AWAITING_MERCHANT
  RESOLVED
}

enum ShortfallResolution {
  COLLECTED
  COMPANY_ABSORBS
  DRIVER_RESPONSIBLE
  MERCHANT_ACCEPTS
}

/// A recipient paid less than the COD. Never assigned to the merchant automatically.
model CodShortfall {
  id                 String               @id @default(uuid(7)) @db.Uuid
  shipmentId         String               @unique @map("shipment_id") @db.Uuid
  merchantId         String               @map("merchant_id") @db.Uuid
  driverId           String               @map("driver_id") @db.Uuid
  expectedAmount     Decimal              @map("expected_amount") @db.Decimal(12, 2)
  /// The driver's explanation at delivery.
  reason             String
  status             ShortfallStatus      @default(OPEN)
  proposedResolution ShortfallResolution? @map("proposed_resolution")
  proposedAmount     Decimal?             @map("proposed_amount") @db.Decimal(12, 2)
  proposalNote       String?              @map("proposal_note")
  proposedById       String?              @map("proposed_by_id") @db.Uuid
  proposedAt         DateTime?            @map("proposed_at")
  resolution         ShortfallResolution?
  resolvedAmount     Decimal?             @map("resolved_amount") @db.Decimal(12, 2)
  decidedById        String?              @map("decided_by_id") @db.Uuid
  decidedAt          DateTime?            @map("decided_at")
  decisionNote       String?              @map("decision_note")
  merchantAcceptedAt DateTime?            @map("merchant_accepted_at")
  journalEntryId     String?              @unique @map("journal_entry_id") @db.Uuid
  version            Int                  @default(0)
  createdAt          DateTime             @default(now()) @map("created_at")
  updatedAt          DateTime             @updatedAt @map("updated_at")

  shipment   Shipment @relation(fields: [shipmentId], references: [id], onDelete: Restrict)
  merchant   User     @relation("ShortfallMerchant", fields: [merchantId], references: [id], onDelete: Restrict)
  driver     User     @relation("ShortfallDriver", fields: [driverId], references: [id], onDelete: Restrict)
  proposedBy User?    @relation("ShortfallProposer", fields: [proposedById], references: [id], onDelete: Restrict)
  decidedBy  User?    @relation("ShortfallDecider", fields: [decidedById], references: [id], onDelete: Restrict)

  @@index([status])
  @@index([merchantId, status])
  @@map("cod_shortfalls")
}

enum AdjustmentType {
  MERCHANT_CREDIT
  MERCHANT_DEBIT
}

/// A requested manual merchant credit/debit. Posted only after a second person approves it.
/// Phase 4C: what a financial adjustment corrects (ADR 0003 §10.4).
enum AdjustmentSourceType {
  /// A delivery fee (shipment required; the posting optional).
  SHIPMENT_FEE
  /// A return fee or delivery charge (shipment required; the posting optional).
  RETURN_CHARGE
  /// A COD shortfall resolution (shipment required; the posting optional).
  COD_SHORTFALL
  /// Any posting on the merchant account, with or without a shipment (payouts, payments, ...).
  JOURNAL_ENTRY
  /// No verified provenance.
  UNLINKED
}

model FinancialAdjustment {
  id                   String               @id @default(uuid(7)) @db.Uuid
  type                 AdjustmentType
  merchantId           String               @map("merchant_id") @db.Uuid
  amount               Decimal              @db.Decimal(12, 2)
  reason               String
  status               ApprovalStatus       @default(PENDING_APPROVAL)
  requestedById        String               @map("requested_by_id") @db.Uuid
  decidedById          String?              @map("decided_by_id") @db.Uuid
  decidedAt            DateTime?            @map("decided_at")
  decisionNote         String?              @map("decision_note")
  journalEntryId       String?              @unique @map("journal_entry_id") @db.Uuid
  createdAt            DateTime             @default(now()) @map("created_at")
  /// Phase 4C (ADR 0003 §10.4): what the adjustment corrects. Fixed when it is requested and never
  /// changed (trigger). UNLINKED (also every adjustment written before this column) means no
  /// verified provenance, so approval needs a fully independent reviewer.
  sourceType           AdjustmentSourceType @default(UNLINKED) @map("source_type")
  sourceShipmentId     String?              @map("source_shipment_id") @db.Uuid
  sourceJournalEntryId String?              @map("source_journal_entry_id") @db.Uuid

  merchant           User          @relation("AdjustmentMerchant", fields: [merchantId], references: [id], onDelete: Restrict)
  requestedBy        User          @relation("AdjustmentRequester", fields: [requestedById], references: [id], onDelete: Restrict)
  decidedBy          User?         @relation("AdjustmentDecider", fields: [decidedById], references: [id], onDelete: Restrict)
  sourceShipment     Shipment?     @relation("AdjustmentSourceShipment", fields: [sourceShipmentId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  sourceJournalEntry JournalEntry? @relation("AdjustmentSourceEntry", fields: [sourceJournalEntryId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([status])
  @@index([sourceShipmentId])
  @@index([sourceJournalEntryId])
  @@map("financial_adjustments")
}

/// Configurable finance values (e.g. the approval threshold). Every change is kept below.
model FinanceSetting {
  key         String   @id
  value       String
  updatedById String?  @map("updated_by_id") @db.Uuid
  updatedAt   DateTime @default(now()) @map("updated_at")

  @@map("finance_settings")
}

model FinanceSettingChange {
  id          String   @id @default(uuid(7)) @db.Uuid
  key         String
  oldValue    String?  @map("old_value")
  newValue    String   @map("new_value")
  reason      String
  changedById String   @map("changed_by_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at")

  changedBy User @relation("SettingChanger", fields: [changedById], references: [id], onDelete: Restrict)

  @@index([key, createdAt])
  @@map("finance_setting_changes")
}

/// Replay protection for money-moving requests (one result per user, scope and key).
model IdempotencyRecord {
  id             String    @id @default(uuid(7)) @db.Uuid
  userId         String    @map("user_id") @db.Uuid
  scope          String
  key            String
  requestHash    String    @map("request_hash")
  responseStatus Int?      @map("response_status")
  responseBody   Json?     @map("response_body")
  createdAt      DateTime  @default(now()) @map("created_at")
  completedAt    DateTime? @map("completed_at")

  @@unique([userId, scope, key])
  @@map("idempotency_records")
}

// ---------------------------------------------------------------------------
// Phase 3 — driver settlements, cash shortages and repayments
// ---------------------------------------------------------------------------

enum CashChannel {
  HUB
  BANK
  EWALLET
}

enum SettlementStatus {
  SUBMITTED
  CONFIRMED
  REJECTED
}

/// A driver handing collected cash to the company. Partial settlements are allowed: only the
/// counted amount is cleared (oldest collections first); the rest stays in the driver's custody.
model DriverSettlement {
  id             String           @id @default(uuid(7)) @db.Uuid
  driverId       String           @map("driver_id") @db.Uuid
  status         SettlementStatus @default(SUBMITTED)
  declaredAmount Decimal          @map("declared_amount") @db.Decimal(12, 2)
  countedAmount  Decimal?         @map("counted_amount") @db.Decimal(12, 2)
  channel        CashChannel      @default(HUB)
  note           String?
  submittedById  String           @map("submitted_by_id") @db.Uuid
  decidedById    String?          @map("decided_by_id") @db.Uuid
  decidedAt      DateTime?        @map("decided_at")
  decisionNote   String?          @map("decision_note")
  journalEntryId String?          @unique @map("journal_entry_id") @db.Uuid
  createdAt      DateTime         @default(now()) @map("created_at")

  driver      User           @relation("SettlementDriver", fields: [driverId], references: [id], onDelete: Restrict)
  submittedBy User           @relation("SettlementSubmitter", fields: [submittedById], references: [id], onDelete: Restrict)
  decidedBy   User?          @relation("SettlementDecider", fields: [decidedById], references: [id], onDelete: Restrict)
  clearings   CashClearing[]

  @@index([driverId, status])
  @@index([status, createdAt])
  @@map("driver_settlements")
}

enum DriverShortageResponsibility {
  DRIVER_LIABLE
  COMPANY_ABSORBS
}

/// Collected cash a driver cannot hand over. Never charged to the merchant: once approved the
/// merchant's pending COD is released to their balance either way.
model DriverCashShortage {
  id             String                       @id @default(uuid(7)) @db.Uuid
  driverId       String                       @map("driver_id") @db.Uuid
  amount         Decimal                      @db.Decimal(12, 2)
  responsibility DriverShortageResponsibility
  reason         String
  status         ApprovalStatus               @default(PENDING_APPROVAL)
  proposedById   String                       @map("proposed_by_id") @db.Uuid
  decidedById    String?                      @map("decided_by_id") @db.Uuid
  decidedAt      DateTime?                    @map("decided_at")
  decisionNote   String?                      @map("decision_note")
  journalEntryId String?                      @unique @map("journal_entry_id") @db.Uuid
  createdAt      DateTime                     @default(now()) @map("created_at")

  driver     User           @relation("ShortageDriver", fields: [driverId], references: [id], onDelete: Restrict)
  proposedBy User           @relation("ShortageProposer", fields: [proposedById], references: [id], onDelete: Restrict)
  decidedBy  User?          @relation("ShortageDecider", fields: [decidedById], references: [id], onDelete: Restrict)
  clearings  CashClearing[]

  @@index([driverId, status])
  @@map("driver_cash_shortages")
}

/// How much of a COD collection a settlement or an approved driver shortage cleared.
model CashClearing {
  id               String   @id @default(uuid(7)) @db.Uuid
  collectionId     String   @map("collection_id") @db.Uuid
  amount           Decimal  @db.Decimal(12, 2)
  settlementId     String?  @map("settlement_id") @db.Uuid
  driverShortageId String?  @map("driver_shortage_id") @db.Uuid
  createdAt        DateTime @default(now()) @map("created_at")

  collection     CodCollection       @relation(fields: [collectionId], references: [id], onDelete: Restrict)
  settlement     DriverSettlement?   @relation(fields: [settlementId], references: [id], onDelete: Restrict)
  driverShortage DriverCashShortage? @relation(fields: [driverShortageId], references: [id], onDelete: Restrict)

  @@index([collectionId])
  @@index([settlementId])
  @@index([driverShortageId])
  @@map("cash_clearings")
}

/// A driver paying back an amount they were held liable for.
model DriverRepayment {
  id               String      @id @default(uuid(7)) @db.Uuid
  driverId         String      @map("driver_id") @db.Uuid
  amount           Decimal     @db.Decimal(12, 2)
  channel          CashChannel @default(HUB)
  /// The receipt or transfer reference of the real payment (normalised). Unique per channel, so
  /// the same cash cannot be posted twice by different accountants. Null only for repayments
  /// recorded before references existed.
  receiptReference String?     @map("receipt_reference")
  note             String?
  recordedById     String      @map("recorded_by_id") @db.Uuid
  journalEntryId   String      @unique @map("journal_entry_id") @db.Uuid
  createdAt        DateTime    @default(now()) @map("created_at")

  driver     User @relation("RepaymentDriver", fields: [driverId], references: [id], onDelete: Restrict)
  recordedBy User @relation("RepaymentRecorder", fields: [recordedById], references: [id], onDelete: Restrict)

  @@unique([channel, receiptReference])
  @@index([driverId])
  @@map("driver_repayments")
}

// ---------------------------------------------------------------------------
// Phase 3 — merchant payouts, merchant payments and treasury transfers
// ---------------------------------------------------------------------------

enum PayoutStatus {
  PENDING_APPROVAL
  APPROVED
  PAID
  CANCELLED
}

enum PaymentMethod {
  CASH
  BANK_TRANSFER
  E_WALLET
  CHEQUE
}

/// Money paid to a merchant from their funded balance. The approver is never the creator;
/// approval reserves the amount; payment posts the ledger entry with a unique reference.
model MerchantPayout {
  id                  String        @id @default(uuid(7)) @db.Uuid
  merchantId          String        @map("merchant_id") @db.Uuid
  amount              Decimal       @db.Decimal(12, 2)
  method              PaymentMethod
  status              PayoutStatus  @default(PENDING_APPROVAL)
  requestedByMerchant Boolean       @default(false) @map("requested_by_merchant")
  note                String?
  createdById         String        @map("created_by_id") @db.Uuid
  approvedById        String?       @map("approved_by_id") @db.Uuid
  approvedAt          DateTime?     @map("approved_at")
  paidById            String?       @map("paid_by_id") @db.Uuid
  paidAt              DateTime?     @map("paid_at")
  /// Bank/wallet/cheque reference, unique per payment method.
  reference           String?
  cancelledById       String?       @map("cancelled_by_id") @db.Uuid
  cancelledAt         DateTime?     @map("cancelled_at")
  cancelReason        String?       @map("cancel_reason")
  journalEntryId      String?       @unique @map("journal_entry_id") @db.Uuid
  createdAt           DateTime      @default(now()) @map("created_at")

  merchant    User  @relation("PayoutMerchant", fields: [merchantId], references: [id], onDelete: Restrict)
  createdBy   User  @relation("PayoutCreator", fields: [createdById], references: [id], onDelete: Restrict)
  approvedBy  User? @relation("PayoutApprover", fields: [approvedById], references: [id], onDelete: Restrict)
  paidBy      User? @relation("PayoutPayer", fields: [paidById], references: [id], onDelete: Restrict)
  cancelledBy User? @relation("PayoutCanceller", fields: [cancelledById], references: [id], onDelete: Restrict)

  @@unique([method, reference])
  @@index([merchantId, status])
  @@index([status, createdAt])
  @@map("merchant_payouts")
}

/// A merchant paying the company (e.g. to settle a debit balance from fees).
model MerchantPayment {
  id             String      @id @default(uuid(7)) @db.Uuid
  merchantId     String      @map("merchant_id") @db.Uuid
  amount         Decimal     @db.Decimal(12, 2)
  channel        CashChannel
  reference      String?
  note           String?
  recordedById   String      @map("recorded_by_id") @db.Uuid
  journalEntryId String      @unique @map("journal_entry_id") @db.Uuid
  createdAt      DateTime    @default(now()) @map("created_at")

  merchant   User @relation("MerchantPaymentMerchant", fields: [merchantId], references: [id], onDelete: Restrict)
  recordedBy User @relation("MerchantPaymentRecorder", fields: [recordedById], references: [id], onDelete: Restrict)

  @@index([merchantId])
  @@map("merchant_payments")
}

/// Moving company money between channels (e.g. depositing hub cash at the bank).
model TreasuryTransfer {
  id             String      @id @default(uuid(7)) @db.Uuid
  fromChannel    CashChannel @map("from_channel")
  toChannel      CashChannel @map("to_channel")
  amount         Decimal     @db.Decimal(12, 2)
  reference      String?
  recordedById   String      @map("recorded_by_id") @db.Uuid
  journalEntryId String      @unique @map("journal_entry_id") @db.Uuid
  createdAt      DateTime    @default(now()) @map("created_at")

  recordedBy User @relation("TransferRecorder", fields: [recordedById], references: [id], onDelete: Restrict)

  @@map("treasury_transfers")
}

// ---------------------------------------------------------------------------
// Phase 3 — returns
// ---------------------------------------------------------------------------

enum ReturnFeeStatus {
  /// No return fee configured for the route: an administrator must set one or waive it.
  RETURN_FEE_UNCONFIGURED
  SET
  WAIVED
  POSTED
}

/// The return of a shipment to its merchant. Physical progress is the shipment status; this
/// record holds the request, approval, return driver and the return fee decision.
model ReturnRecord {
  id                       String          @id @default(uuid(7)) @db.Uuid
  shipmentId               String          @unique @map("shipment_id") @db.Uuid
  requestedById            String?         @map("requested_by_id") @db.Uuid
  requestReason            String?         @map("request_reason")
  requestedAt              DateTime        @default(now()) @map("requested_at")
  approvedById             String?         @map("approved_by_id") @db.Uuid
  approvedAt               DateTime?       @map("approved_at")
  returnDriverId           String?         @map("return_driver_id") @db.Uuid
  /// The delivery driver before the return was assigned (for the record).
  originalDriverId         String?         @map("original_driver_id") @db.Uuid
  feeStatus                ReturnFeeStatus @map("fee_status")
  /// The return fee itself (excludes `deliveryCharge`).
  feeAmount                Decimal?        @map("fee_amount") @db.Decimal(12, 2)
  /// Policy copied from the pricing snapshot when the return record is created.
  feePolicy                ReturnFeePolicy @default(RETURN_ONLY) @map("fee_policy")
  /// Delivery or failed-attempt fee charged with the return (0 for RETURN_ONLY), fixed when the
  /// record is created. Posted together with the return fee, or waived with it.
  deliveryCharge           Decimal         @default(0) @map("delivery_charge") @db.Decimal(12, 2)
  feeSetById               String?         @map("fee_set_by_id") @db.Uuid
  feeSetAt                 DateTime?       @map("fee_set_at")
  feeReason                String?         @map("fee_reason")
  journalEntryId           String?         @unique @map("journal_entry_id") @db.Uuid
  completedAt              DateTime?       @map("completed_at")
  closedAt                 DateTime?       @map("closed_at")
  createdAt                DateTime        @default(now()) @map("created_at")
  updatedAt                DateTime        @updatedAt @map("updated_at")
  /// Phase 4C: set when the return was requested during an impersonation (`requestedById` is
  /// then the real SUPER_ADMIN, checked by a composite key).
  requestedImpersonationId String?         @map("requested_impersonation_id") @db.Uuid

  shipment               Shipment              @relation(fields: [shipmentId], references: [id], onDelete: Restrict)
  requestedBy            User?                 @relation("ReturnRequester", fields: [requestedById], references: [id], onDelete: Restrict)
  requestedImpersonation ImpersonationSession? @relation("ReturnImpersonation", fields: [requestedImpersonationId, requestedById], references: [id, actorUserId], onDelete: Restrict, onUpdate: Restrict)
  approvedBy             User?                 @relation("ReturnApprover", fields: [approvedById], references: [id], onDelete: Restrict)
  returnDriver           User?                 @relation("ReturnDriver", fields: [returnDriverId], references: [id], onDelete: Restrict)
  feeSetBy               User?                 @relation("ReturnFeeSetter", fields: [feeSetById], references: [id], onDelete: Restrict)

  @@index([feeStatus])
  @@index([closedAt])
  @@index([requestedImpersonationId])
  @@map("return_records")
}

// ---------------------------------------------------------------------------
// Phase 4C — SUPER_ADMIN impersonation (ADR 0003). Created by migration 14; not used by the
// application until impersonation is enabled.
// ---------------------------------------------------------------------------

enum ImpersonationEndReason {
  MANUAL
  EXPIRED
  ACTOR_LOGOUT
  ACTOR_SESSION_ENDED
  ACTOR_REVOKED
  TARGET_REVOKED
}

/// One impersonation: a SUPER_ADMIN (actor) operating a MERCHANT or DRIVER account (target).
/// Rows are never deleted; the database enforces (see migration 14 CHECK constraints):
/// - at most one active impersonation per actor and per target (`active_*` slot columns),
/// - the target role is MERCHANT or DRIVER and matches the client app,
/// - never the actor themselves, and at most 30 minutes long.
model ImpersonationSession {
  id              String                  @id @default(uuid(7)) @db.Uuid
  actorUserId     String                  @map("actor_user_id") @db.Uuid
  /// The admin session the impersonation was started from (it ends with it).
  actorSessionId  String                  @map("actor_session_id") @db.Uuid
  targetUserId    String                  @map("target_user_id") @db.Uuid
  targetRole      UserRole                @map("target_role")
  clientApp       ClientApp               @map("client_app")
  reason          String
  ticketReference String?                 @map("ticket_reference")
  /// Equal to `actorUserId` / `targetUserId` while active and NULL once ended. Unique, so two
  /// active impersonations can never share an actor or a target.
  activeActorId   String?                 @unique @map("active_actor_id") @db.Uuid
  activeTargetId  String?                 @unique @map("active_target_id") @db.Uuid
  startedAt       DateTime                @default(now()) @map("started_at")
  /// `startedAt` + 30 minutes at most; never extended.
  expiresAt       DateTime                @map("expires_at")
  endedAt         DateTime?               @map("ended_at")
  endedReason     ImpersonationEndReason? @map("ended_reason")
  ipAddress       String?                 @map("ip_address")
  userAgent       String?                 @map("user_agent")

  actor                     User                       @relation("ImpersonationActor", fields: [actorUserId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  target                    User                       @relation("ImpersonationTarget", fields: [targetUserId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  actorSession              Session                    @relation("ImpersonationActorSession", fields: [actorSessionId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  temporarySessions         Session[]                  @relation("ImpersonationTemporarySession")
  exchangeCode              ImpersonationExchangeCode?
  auditEntriesAsActor       AuditLog[]                 @relation("AuditImpersonationActor")
  auditEntriesAsTarget      AuditLog[]                 @relation("AuditImpersonationTarget")
  historyEntries            ShipmentStatusHistory[]    @relation("HistoryImpersonation")
  createdShipmentsAsActor   Shipment[]                 @relation("ShipmentImpersonationActor")
  createdShipmentsForTarget Shipment[]                 @relation("ShipmentImpersonationTarget")
  returnRequests            ReturnRecord[]             @relation("ReturnImpersonation")
  quotesAsActor             PricingQuote[]             @relation("QuoteImpersonationActor")
  quotesForTarget           PricingQuote[]             @relation("QuoteImpersonationTarget")
  notifications             NotificationOutbox[]

  // Targets of the composite foreign keys that tie records to this impersonation's people.
  @@unique([id, actorUserId])
  @@unique([id, targetUserId])
  @@index([actorUserId, startedAt(sort: Desc)])
  @@index([targetUserId, startedAt(sort: Desc)])
  @@index([actorSessionId])
  @@index([endedAt, expiresAt])
  @@map("impersonation_sessions")
}

/// Single-use code that hands an impersonation to the target app tab (valid 60 seconds).
/// Only the SHA-256 hash of the code is stored, with the challenge of the tab's verifier.
model ImpersonationExchangeCode {
  id              String    @id @default(uuid(7)) @db.Uuid
  impersonationId String    @unique @map("impersonation_id") @db.Uuid
  codeHash        String    @unique @map("code_hash")
  /// base64url SHA-256 of the verifier held only in memory by the opened app tab.
  codeChallenge   String    @map("code_challenge")
  expiresAt       DateTime  @map("expires_at")
  usedAt          DateTime? @map("used_at")
  createdAt       DateTime  @default(now()) @map("created_at")

  impersonation ImpersonationSession @relation(fields: [impersonationId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@map("impersonation_exchange_codes")
}

enum NotificationKind {
  IMPERSONATION_SUMMARY
}

enum NotificationStatus {
  PENDING
  SENT
  FAILED
}

/// Durable outbox for emails that must not block or be lost (written in the same transaction as
/// the event). Holds references only; the message is rendered when it is sent.
model NotificationOutbox {
  id              String             @id @default(uuid(7)) @db.Uuid
  kind            NotificationKind
  /// One notification per business event, e.g. `impersonation-summary:<impersonation id>`.
  dedupeKey       String             @unique @map("dedupe_key")
  recipientUserId String             @map("recipient_user_id") @db.Uuid
  impersonationId String?            @map("impersonation_id") @db.Uuid
  status          NotificationStatus @default(PENDING)
  attempts        Int                @default(0)
  nextAttemptAt   DateTime           @default(now()) @map("next_attempt_at")
  /// Fencing token of the sender that claimed the row; only that sender may complete it.
  leaseToken      String?            @map("lease_token") @db.Uuid
  leaseExpiresAt  DateTime?          @map("lease_expires_at")
  /// Short error text from the last failed attempt (never message content).
  lastError       String?            @map("last_error")
  sentAt          DateTime?          @map("sent_at")
  createdAt       DateTime           @default(now()) @map("created_at")
  updatedAt       DateTime           @updatedAt @map("updated_at")

  recipient     User                  @relation("NotificationRecipient", fields: [recipientUserId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  impersonation ImpersonationSession? @relation(fields: [impersonationId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([status, nextAttemptAt])
  @@index([impersonationId])
  @@map("notification_outbox")
}
