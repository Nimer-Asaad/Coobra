# ---------------------------------------------------------------------------
# COOBRA root environment (used by apps/api and packages/database).
# Copy to `.env` and fill in values. Never commit `.env`.
# ---------------------------------------------------------------------------

# --- Docker Compose (local development only) ---
POSTGRES_USER=coobra
POSTGRES_PASSWORD=
POSTGRES_DB=coobra_dev
POSTGRES_PORT=5432

# --- Database ---
# postgresql://USER:PASSWORD@localhost:5432/coobra_dev?schema=public
DATABASE_URL=
# Separate database used by API integration tests (it is wiped by the tests).
TEST_DATABASE_URL=

# --- API ---
NODE_ENV=development
API_PORT=4000
# Comma-separated list of browser origins allowed to call the API.
CORS_ORIGINS=http://localhost:3000,http://localhost:8081,http://localhost:8082

# Session lifetimes
SESSION_TTL_HOURS_ADMIN=12
SESSION_TTL_DAYS_MOBILE=30
# Set to true when the API is served over HTTPS (always true in production).
COOKIE_SECURE=false
# Number of reverse proxies in front of the API (0 when reached directly). Required in
# production, never guessed: it decides the client address for rate limits and the audit log.
# See docs/deployment.md.
TRUST_PROXY=0

# Public URLs used to build links in emails (verification / password reset).
ADMIN_WEB_URL=http://localhost:3000
MERCHANT_APP_URL=http://localhost:8082
DRIVER_APP_URL=http://localhost:8081

# --- Mail ---
# smtp: send through SMTP (Mailpit in development).
# log:  print emails to the API console (development only; refused in production).
MAIL_TRANSPORT=smtp
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="COOBRA <no-reply@coobra.local>"

# --- Impersonation (ADR 0003) ---
# Impersonated writes are off unless explicitly enabled (default false in every environment).
IMPERSONATION_WRITES_ENABLED=false
# R2 confirmation signing keys: "<kid>:<base64url secret of at least 32 bytes>", comma-separated.
# The active key signs; the others only verify (rotation). Generate a secret with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Never commit real keys. Writes stay disabled (fail closed) without a valid key ring.
CONSEQUENCE_SIGNING_KEYS=
CONSEQUENCE_SIGNING_ACTIVE_KEY=
# Production only (R4): the API's public HTTPS URL and the approved site of every host.
API_PUBLIC_URL=
IMPERSONATION_SITE=
