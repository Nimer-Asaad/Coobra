    "create-super-admin": "node dist/cli/create-super-admin.js"
  },
  "dependencies": {
    "@coobra/database": "workspace:*",
    "@coobra/i18n": "workspace:*",
    "@coobra/shared": "workspace:*",
    "@nestjs/common": "12.2.0",
    "@nestjs/core": "12.2.0",
    "@nestjs/platform-express": "12.2.0",
    "@nestjs/throttler": "6.7.1",
    "argon2": "0.45.1",
    "helmet": "8.3.0",
    "nodemailer": "10.2.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@nestjs/cli": "12.0.10",
    "@nestjs/schematics": "12.0.10",
    "@nestjs/testing": "12.2.0",
    "@types/express": "5.0.6",
    "@types/node": "24.19.2",
    "@types/nodemailer": "8.0.2",
    "@types/supertest": "7.2.1",
    "eslint": "9.39.5",
    "globals": "16.5.0",
    "supertest": "7.3.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "8.72.0",
    "vitest": "4.1.12"
  }
