{
  "expo": {
    "name": "COOBRA Merchant",
    "slug": "coobra-merchant",
    "scheme": "coobra-merchant",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "ios": {
      "bundleIdentifier": "com.coobra.merchant",
      "supportsTablet": true
    },
    "android": {
      "package": "com.coobra.merchant"
    },
    "web": {
      "output": "single",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-localization",
        {
          "supportsRTL": true
        }
      ]
    ]
  }
}
