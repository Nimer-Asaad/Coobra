# Base URL of the COOBRA API.
# On a physical phone use your computer's LAN IP (e.g. http://192.168.1.10:4000), not localhost.
EXPO_PUBLIC_API_URL=http://localhost:4000

# Exact origin of the admin console: the only window that may open an impersonation in this app.
# Defaults to http://localhost:3000 in development; required in production builds.
EXPO_PUBLIC_ADMIN_WEB_URL=http://localhost:3000
