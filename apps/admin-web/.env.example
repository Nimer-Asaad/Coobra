# Server-side only: base URL of the COOBRA API (never exposed to the browser).
API_URL=http://localhost:4000
# Server-side only: the merchant and driver web apps, where an impersonation opens
# (the same values as the API's MERCHANT_APP_URL and DRIVER_APP_URL; required in production).
MERCHANT_APP_URL=http://localhost:8082
DRIVER_APP_URL=http://localhost:8081
